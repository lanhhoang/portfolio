<% page_metadata(
  title: t("seo.about.title"),
  description: @translation.introduction,
  alternates: alternate_locale_links(locale_switch_paths: @locale_switch_paths),
  image_url: (@profile.portrait.attached? ? url_for(@profile.portrait) : nil),
  json_ld: person_json_ld(@translation)
) %>

<main id="main-content" class="site-container page-shell" tabindex="-1">
  <article class="page-stack">
    <div class="hero">
      <header class="page-header">
        <h1><%= @translation.display_name %></h1>
        <p class="type-lede"><%= @translation.introduction %></p>
        <p class="availability"><%= @translation.availability_label %></p>
      </header>

      <% if @profile.portrait.attached? %>
        <div class="hero-portrait">
          <%= responsive_image_tag(
            @profile.portrait,
            alt: @translation.display_name,
            sizes: "(min-width: 56rem) 24rem, 100vw",
            widths: [320, 480, 640, 960],
            loading: "eager",
            class: "max-w-full"
          ) %>
        </div>
      <% end %>
    </div>

    <div class="with-aside">
      <div class="rich-text"><%= sanitize @translation.biography_html %></div>

      <aside class="aside-links" aria-labelledby="about-links-title">
        <h2 id="about-links-title" class="type-label"><%= t("public.about.links") %></h2>
        <ul>
          <li><%= mail_to @profile.public_contact_email %></li>
          <% @profile.social_links.sort.each do |label, url| %>
            <li><%= link_to label, url, rel: "me noopener" %></li>
          <% end %>
        </ul>
      </aside>
    </div>
  </article>
</main>
