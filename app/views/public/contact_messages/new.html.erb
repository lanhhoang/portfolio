<% page_metadata(title: t("seo.contact.title"), description: t("seo.contact.description")) %>

<main id="main-content" class="site-container page-shell page-stack" tabindex="-1" aria-labelledby="contact-title">
  <header class="page-header">
    <h1 id="contact-title"><%= t("pages.contact.title") %></h1>
    <p class="type-lede"><%= t("pages.contact.introduction") %></p>
  </header>

  <div class="with-aside">
    <div class="with-aside-main">
      <% if notice.present? %><p role="status" class="form-message"><%= notice %></p><% end %>
      <% if alert.present? %><p role="alert" class="form-message"><%= alert %></p><% end %>

      <%= form_with model: @contact_message, url: localized_contact_path(locale: I18n.locale), class: "form-stack" do |form| %>
        <% if @contact_message.errors.any? %>
          <div role="alert" class="form-message">
            <p class="font-semibold"><%= t("contact.errors", count: @contact_message.errors.count) %></p>
            <ul>
              <% @contact_message.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
          <%= label_tag "contact_message_website", t("contact.fields.website") %>
          <%= text_field_tag "contact_message[website]", nil, id: "contact_message_website", tabindex: -1, autocomplete: "off" %>
        </div>

        <% {
          sender_name: [ "text", 120 ],
          sender_email: [ "email", 254 ],
          subject: [ "text", 200 ]
        }.each do |field, (type, maxlength)| %>
          <div>
            <%= form.label field, t("contact.fields.#{field}") %>
            <%= form.public_send("#{type}_field", field, required: true, maxlength: maxlength) %>
          </div>
        <% end %>

        <div>
          <%= form.label :body, t("contact.fields.body") %>
          <%= form.text_area :body, required: true, rows: 8, maxlength: 10_000 %>
        </div>

        <%= form.submit t("contact.submit"), class: "button justify-self-start" %>
      <% end %>
    </div>

    <% if site_profile %>
      <aside class="aside-links" aria-labelledby="contact-direct-title">
        <h2 id="contact-direct-title" class="type-label"><%= t("public.contact.direct") %></h2>
        <ul>
          <li><%= mail_to site_profile.public_contact_email %></li>
          <% site_profile.social_links.sort.each do |label, url| %>
            <li><%= link_to label, url, rel: "me noopener" %></li>
          <% end %>
        </ul>
      </aside>
    <% end %>
  </div>
</main>
