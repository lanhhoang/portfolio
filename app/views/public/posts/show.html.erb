<% page_metadata(
  title: @translation.title,
  description: @translation.excerpt,
  alternates: alternate_locale_links(locale_switch_paths: @locale_switch_paths),
  og_type: "article",
  image_url: (@translation.post.cover_image.attached? ? url_for(@translation.post.cover_image) : nil),
  json_ld: post_json_ld(@translation)
) %>

<main id="main-content" class="site-container page-shell" tabindex="-1">
  <article class="grid gap-12">
    <header class="page-header">
      <%= time_tag @translation.published_at.to_date, l(@translation.published_at.to_date, format: :long), class: "entry-meta" %>
      <h1><%= @translation.title %></h1>
      <p class="type-lede"><%= @translation.excerpt %></p>
      <%= render "public/shared/tags", taggable: @translation.post %>
    </header>

    <% if @translation.post.cover_image.attached? %>
      <%= responsive_image_tag(
        @translation.post.cover_image,
        alt: @translation.title,
        sizes: "(min-width: 80rem) 80rem, 100vw",
        widths: [640, 960, 1280, 1600],
        loading: "eager",
        fetchpriority: "high",
        class: "case-cover"
      ) %>
    <% end %>

    <div class="rich-text"><%= sanitize @translation.body_html %></div>

    <footer class="page-end">
      <nav class="page-end-nav" aria-label="<%= t("public.posts.more") %>">
        <% if @older_translation %>
          <div>
            <p class="entry-meta"><%= t("public.posts.older") %></p>
            <%= link_to @older_translation.title, localized_post_path(locale: current_locale, slug: @older_translation.slug), class: "type-heading" %>
          </div>
        <% end %>
        <% if @newer_translation %>
          <div>
            <p class="entry-meta"><%= t("public.posts.newer") %></p>
            <%= link_to @newer_translation.title, localized_post_path(locale: current_locale, slug: @newer_translation.slug), class: "type-heading" %>
          </div>
        <% end %>
        <%= link_to t("public.posts.all"), localized_blog_path(locale: current_locale), class: "page-end-back" %>
      </nav>
      <%= render "public/shared/next_step" %>
    </footer>
  </article>
</main>
