<% page_metadata(title: t("seo.blog.title"), description: t("seo.blog.description")) %>

<main id="main-content" class="site-container page-shell grid gap-12" tabindex="-1">
  <header class="page-header">
    <h1 class="text-4xl font-bold"><%= t("public.posts.title") %></h1>
    <p class="max-w-prose text-lg"><%= t("pages.blog.introduction") %></p>
  </header>

  <%= form_with url: localized_blog_path(locale: current_locale), method: :get, class: "search-bar", html: { role: "search" } do |form| %>
    <div>
      <%= form.label :q, t("public.search.label") %>
      <%= form.search_field :q, value: params[:q], class: "min-h-11" %>
    </div>
    <div>
      <%= form.label :tag, t("public.tags.label") %>
      <%= form.select :tag,
        options_for_select([[t("public.tags.all"), ""]] + @tag_translations.map { |tag| [tag.name, tag.slug] }, params[:tag]),
        {}, class: "min-h-11" %>
    </div>
    <%= form.submit t("public.search.submit"), class: "min-h-11" %>
  <% end %>

  <% if @translations.any? %>
    <ol class="entry-list">
      <% @translations.each do |translation| %>
        <li>
          <article class="entry">
            <%= time_tag translation.published_at.to_date, l(translation.published_at.to_date, format: :long), class: "entry-meta" %>
            <div class="entry-text">
              <h2 class="text-2xl font-bold"><%= link_to translation.title, localized_post_path(locale: current_locale, slug: translation.slug) %></h2>
              <p class="max-w-prose"><%= translation.excerpt %></p>
              <%= render "public/shared/tags", taggable: translation.post %>
            </div>
          </article>
        </li>
      <% end %>
    </ol>
  <% else %>
    <% if params[:q].present? || params[:tag].present? %>
      <p><%= t("public.posts.no_matches") %></p>
      <%= link_to t("public.search.clear"), localized_blog_path(locale: current_locale), class: "inline-flex min-h-11 items-center" %>
    <% else %>
      <p><%= t("public.posts.empty") %></p>
    <% end %>
  <% end %>
</main>
