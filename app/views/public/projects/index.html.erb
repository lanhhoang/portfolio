<% page_metadata(title: t("seo.projects.title"), description: t("seo.projects.description")) %>

<main id="main-content" class="site-container page-shell grid gap-12" tabindex="-1">
  <header class="page-header">
    <h1 class="text-4xl font-bold"><%= t("public.projects.title") %></h1>
    <p class="max-w-prose text-lg"><%= t("pages.projects.introduction") %></p>
  </header>

  <%= form_with url: localized_projects_path(locale: current_locale), method: :get, class: "search-bar", html: { role: "search" } do |form| %>
    <div>
      <%= form.label :q, t("public.search.label") %>
      <%= form.search_field :q, value: params[:q], class: "min-h-11" %>
    </div>
    <div>
      <%= form.label :tag, t("public.tags.label") %>
      <%= form.select :tag,
        options_for_select([[t("public.tags.all"), ""]] + @tag_translations.map { |tag| [tag.name, tag.slug] }, params[:tag]),
        {}, class: "min-h-11" %>
    </div>
    <%= form.submit t("public.search.submit"), class: "min-h-11" %>
  <% end %>

  <% if @translations.any? %>
    <div class="entry-list">
      <% @translations.each do |translation| %>
        <article class="entry">
          <% if translation.project.cover_image.attached? %>
            <div class="entry-media">
              <%= responsive_image_tag(
                translation.project.cover_image,
                alt: translation.title,
                sizes: "(min-width: 80rem) 32rem, (min-width: 56rem) 40vw, 100vw",
                class: "max-w-full"
              ) %>
            </div>
          <% end %>
          <div class="entry-text">
            <h2 class="text-2xl font-bold"><%= link_to translation.title, localized_project_path(locale: current_locale, slug: translation.slug) %></h2>
            <p class="max-w-prose"><%= translation.summary %></p>
            <%= render "public/shared/tags", taggable: translation.project %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <% if params[:q].present? || params[:tag].present? %>
      <p><%= t("public.projects.no_matches") %></p>
      <%= link_to t("public.search.clear"), localized_projects_path(locale: current_locale), class: "inline-flex min-h-11 items-center" %>
    <% else %>
      <p><%= t("public.projects.empty") %></p>
    <% end %>
  <% end %>
</main>
