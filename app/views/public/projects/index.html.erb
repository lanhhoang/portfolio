<% page_metadata(title: t("seo.projects.title"), description: t("seo.projects.description")) %>

<main id="main-content" class="site-container page-shell grid gap-12" tabindex="-1">
  <header class="page-header">
    <h1><%= t("public.projects.title") %></h1>
    <p class="type-lede"><%= t("pages.projects.introduction") %></p>
  </header>

  <% if @search_offered %>
    <%= form_with url: localized_projects_path(locale: current_locale), method: :get, class: "search-bar", html: { role: "search" } do |form| %>
      <div>
        <%= form.label :q, t("public.search.label") %>
        <%= form.search_field :q, value: params[:q] %>
      </div>
      <div>
        <%= form.label :tag, t("public.tags.label") %>
        <%= form.select :tag,
          options_for_select([[t("public.tags.all"), ""]] + @tag_translations.map { |tag| [tag.name, tag.slug] }, params[:tag]),
          {} %>
      </div>
      <%= form.submit t("public.search.submit"), class: "button" %>
    <% end %>
  <% end %>

  <% if @translations.any? %>
    <ul class="entry-list">
      <% @translations.each do |translation| %>
        <li><%= render "public/projects/entry", translation: translation, heading: :h2, tags: true %></li>
      <% end %>
    </ul>
  <% else %>
    <% if params[:q].present? || params[:tag].present? %>
      <p><%= t("public.projects.no_matches") %></p>
      <%= link_to t("public.search.clear"), localized_projects_path(locale: current_locale), class: "inline-flex min-h-11 items-center" %>
    <% else %>
      <p><%= t("public.projects.empty") %></p>
    <% end %>
  <% end %>
</main>
