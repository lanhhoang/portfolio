<% page_metadata(title: t("seo.home.title", name: site_name, title: @profile_translation&.job_title.presence || t("seo.home.fallback_title")), description: t("seo.home.description")) %>

<main id="main-content" class="site-container page-shell page-stack" tabindex="-1">
  <% if @profile_translation %>
    <section aria-labelledby="home-heading" class="hero">
      <div class="hero-text">
        <div class="hero-name">
          <h1 id="home-heading" class="type-display"><%= @profile_translation.display_name %></h1>
          <% languages = PublicController::SUPPORTED_LOCALES.map do |locale|
            link_to t("locales.#{locale}"), localized_root_path(locale: locale),
              lang: locale, hreflang: locale, aria: { current: ("true" if locale == current_locale.to_s) }
          end %>
          <p class="hero-role"><%= t("public.home.role_html", title: @profile_translation.job_title, languages: safe_join(languages, content_tag(:span, " · ", class: "hero-role-sep", aria: { hidden: true }))) %></p>
        </div>
        <p class="type-statement"><%= @profile_translation.headline %></p>
        <p class="type-lede"><%= @profile_translation.introduction %></p>
        <p class="availability"><%= @profile_translation.availability_label %></p>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <li><%= link_to t("public.home.view_work"), localized_projects_path(locale: current_locale), class: "button button-primary" %></li>
          <li>
            <% if @resume_pdf %>
              <span class="inline-flex min-h-11 items-center gap-2">
                <%= link_to t("public.resume.download"), localized_resume_download_path(locale: current_locale) %>
                <span class="type-meta"><%= number_to_human_size(@resume_pdf.byte_size, precision: 2) %></span>
              </span>
            <% else %>
              <%= link_to t("public.home.view_resume"), localized_resume_path(locale: current_locale), class: "inline-flex min-h-11 items-center" %>
            <% end %>
          </li>
        </ul>
      </div>
      <% if @profile.portrait.attached? %>
        <div class="hero-portrait">
          <%= responsive_image_tag(
            @profile.portrait,
            alt: @profile_translation.display_name,
            sizes: "(min-width: 56rem) 24rem, 100vw",
            widths: [320, 480, 640, 960],
            class: "max-w-full"
          ) %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section aria-labelledby="selected-work-heading" class="rail">
    <h2 id="selected-work-heading" class="type-label"><%= t("public.home.selected_work") %></h2>
    <% if @projects.any? %>
      <ul class="entry-list">
        <% @projects.each_with_index do |translation, index| %>
          <li><%= render "public/projects/entry", translation: translation, heading: :h3, lead: index.zero? %></li>
        <% end %>
      </ul>
    <% else %>
      <p><%= t("public.home.no_projects") %></p>
    <% end %>
  </section>

  <section aria-labelledby="recent-writing-heading" class="rail">
    <h2 id="recent-writing-heading" class="type-label"><%= t("public.home.recent_writing") %></h2>
    <% if @posts.any? %>
      <ol class="entry-list">
        <% @posts.each do |translation| %>
          <li class="entry">
            <%= time_tag translation.published_at.to_date, l(translation.published_at.to_date, format: :long), class: "entry-meta" %>
            <div class="entry-text">
              <h3 class="type-heading"><%= link_to translation.title, localized_post_path(locale: current_locale, slug: translation.slug) %></h3>
              <p class="max-w-prose"><%= translation.excerpt %></p>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p><%= t("public.home.no_posts") %></p>
    <% end %>
  </section>

  <section aria-labelledby="contact-heading" class="rail">
    <h2 id="contact-heading" class="type-label"><%= t("public.home.contact") %></h2>
    <div class="grid justify-items-start gap-3">
      <p class="type-prompt"><%= t("public.home.contact_prompt") %></p>
      <%= link_to t("public.home.contact_action"), localized_contact_path(locale: current_locale), class: "button" %>
    </div>
  </section>
</main>
