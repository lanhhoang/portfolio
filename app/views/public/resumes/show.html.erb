<% page_metadata(
  title: t("pages.resume.title"),
  description: @translation.description,
  alternates: alternate_locale_links(locale_switch_paths: @locale_switch_paths)
) %>

<main id="main-content" class="site-container page-shell" tabindex="-1">
  <article class="page-stack">
    <header class="page-header justify-items-start">
      <h1><%= t("pages.resume.title") %></h1>
      <p class="type-lede"><%= @translation.description %></p>
      <p class="type-meta"><%= t("public.resume.updated", date: l(@resume.updated_on, format: :long)) %></p>
      <div class="action-row">
        <% if @translation.pdf.attached? %>
          <%= link_to localized_resume_download_path(locale: current_locale), class: "button" do %>
            <%= t("public.resume.download") %>
            <span class="button-meta"><%= number_to_human_size(@translation.pdf.byte_size, precision: 2) %></span>
          <% end %>
        <% else %>
          <p><%= t("public.resume.pdf_unavailable") %></p>
        <% end %>
        <%= link_to t("public.resume.see_work"), localized_projects_path(locale: current_locale), class: "inline-flex min-h-11 items-center" %>
      </div>
    </header>
    <%= render "public/shared/next_step" %>
  </article>
</main>
