<div class="grid gap-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Posts</h1>
    <%= link_to "New post", new_admin_post_path, class: "admin-action" %>
  </div>
  <% @posts.each do |post| %>
    <article class="admin-card grid gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-lg font-semibold"><%= post.translations.find { |t| t.locale == "en" }&.title || "Post ##{post.id}" %></h2>
        <% post.translations.each do |translation| %>
          <span class="text-xs uppercase opacity-70"><%= translation.locale %></span>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Edit", edit_admin_post_path(post), class: "admin-action" %>
        <%= button_to "Delete", admin_post_path(post), method: :delete,
          class: "admin-action",
          form: { data: { turbo_confirm: "Delete this post and all translations?" } } %>
      </div>
    </article>
  <% end %>
</div>
