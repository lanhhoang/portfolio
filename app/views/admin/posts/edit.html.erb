<h1 class="mb-6 text-2xl font-semibold">Edit post</h1>
<%= render "form", post: @post %>

<% if @post.cover_image.attached? %>
  <section class="admin-card mt-6">
    <p class="mb-2 text-sm opacity-70">Cover image: <%= @post.cover_image.filename %></p>
    <%= button_to "Remove cover image", admin_post_cover_image_path(@post), method: :delete,
      class: "admin-action",
      form: { data: { turbo_confirm: "Remove the cover image?" } } %>
  </section>
<% end %>
