<main class="grid gap-6">
  <h1 class="text-2xl font-semibold">Dashboard</h1>

  <div class="grid gap-4 sm:grid-cols-3">
    <%= link_to admin_projects_path, class: "admin-card" do %>
      <p class="text-sm opacity-70">Projects</p>
      <p class="text-3xl font-semibold" data-testid="project-count"><%= @project_count %></p>
    <% end %>
    <%= link_to admin_posts_path, class: "admin-card" do %>
      <p class="text-sm opacity-70">Posts</p>
      <p class="text-3xl font-semibold" data-testid="post-count"><%= @post_count %></p>
    <% end %>
    <%= link_to admin_tags_path, class: "admin-card" do %>
      <p class="text-sm opacity-70">Tags</p>
      <p class="text-3xl font-semibold" data-testid="tag-count"><%= @tag_count %></p>
    <% end %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to "Edit profile", edit_admin_profile_path, class: "admin-action" %>
    <%= link_to "Edit résumé", edit_admin_resume_path, class: "admin-action" %>
  </div>
</main>
