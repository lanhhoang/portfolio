<%= render "admin/shared/translation_controls", form:, translation: form.object %>
<div>
  <%= form.label :title %>
  <%= form.text_field :title %>
</div>
<div>
  <%= form.label :slug, "Slug" %>
  <%= form.text_field :slug %>
  <p class="text-sm opacity-70">Generated from the title when first saved; later title changes do not change it.</p>
</div>
<div>
  <%= form.label :role %>
  <%= form.text_field :role %>
  <p class="text-sm opacity-70">Your role on this project, in this language. Shown beside the title and years.</p>
</div>
<div>
  <%= form.label :summary %>
  <%= form.text_area :summary, rows: 3 %>
</div>
<div>
  <%= form.label :outcome %>
  <%= form.text_area :outcome, rows: 2 %>
  <p class="text-sm opacity-70">Optional. One or two sentences on the measurable result. Leave blank rather than guess.</p>
</div>
<div>
  <%= form.label :gallery_captions, "Gallery captions" %>
  <%= form.text_area :gallery_captions, rows: 4 %>
  <p class="text-sm opacity-70">One line per gallery image, in upload order. Each line is shown under its image and read aloud by screen readers. Describe what the image shows; leave a line blank to skip an image.</p>
</div>
<%= render "admin/shared/markdown_editor", form: form, attribute: :body_markdown, label: "Body (Markdown)" %>
