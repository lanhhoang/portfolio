<div class="grid gap-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Projects</h1>
    <%= link_to "New project", new_admin_project_path, class: "admin-action" %>
  </div>
  <% @projects.each do |project| %>
    <article class="admin-card grid gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-lg font-semibold"><%= project.translations.find { |t| t.locale == "en" }&.title || "Project ##{project.id}" %></h2>
        <% project.translations.each do |translation| %>
          <span class="text-xs uppercase opacity-70"><%= translation.locale %></span>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Edit", edit_admin_project_path(project), class: "admin-action" %>
        <%= button_to "Delete", admin_project_path(project), method: :delete,
          class: "admin-action",
          form: { data: { turbo_confirm: "Delete this project and all translations?" } } %>
      </div>
    </article>
  <% end %>
</div>
