<%= render "admin/shared/translation_controls", form:, translation: form.object %>
<div>
  <%= form.label :display_name, "Display name" %>
  <%= form.text_field :display_name %>
</div>
<div>
  <%= form.label :job_title, "Job title" %>
  <%= form.text_field :job_title %>
  <p class="text-sm opacity-70">Shown under your name and in the home page title, e.g. "Senior product engineer".</p>
</div>
<div>
  <%= form.label :headline %>
  <%= form.text_field :headline %>
</div>
<div>
  <%= form.label :introduction %>
  <%= form.text_area :introduction, rows: 3 %>
</div>
<div>
  <%= form.label :availability_label, "Availability label" %>
  <%= form.text_field :availability_label %>
</div>
<%= render "admin/shared/markdown_editor", form: form, attribute: :biography_markdown, label: "Biography (Markdown)" %>
