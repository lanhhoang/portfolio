<header
  class="site-header"
  data-controller="menu"
  data-menu-open-label-value="<%= t("menu.open") %>"
  data-menu-close-label-value="<%= t("menu.close") %>">
  <div class="site-container header-grid">
    <%= link_to site_name, localized_root_path(locale: current_locale), class: "site-mark" %>

    <button
      class="menu-button"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      data-menu-target="button"
      data-action="menu#toggle">
      <span data-menu-target="label"><%= t("menu.open") %></span>
    </button>

    <nav
      id="primary-navigation"
      class="primary-navigation"
      aria-label="<%= t("navigation.label") %>"
      data-menu-target="panel">
      <% [
        ["public/projects", nil, t("navigation.work"), localized_projects_path(locale: current_locale)],
        ["public/posts", nil, t("navigation.writing"), localized_blog_path(locale: current_locale)],
        ["public/profiles", nil, t("navigation.about"), localized_about_path(locale: current_locale)],
        ["public/resumes", nil, t("navigation.resume"), localized_resume_path(locale: current_locale)],
        ["public/contact_messages", nil, t("navigation.contact"), localized_contact_path(locale: current_locale)]
      ].each do |target_controller, target_action, label, path| %>
        <%= link_to label, path, aria: { current: ("page" if controller_path == target_controller && (target_action.nil? || action_name == target_action)) } %>
      <% end %>
    </nav>

    <nav class="locale-switcher" aria-label="<%= t("locales.label") %>">
      <% PublicController::SUPPORTED_LOCALES.each do |locale| %>
        <% switch_path = locale_switch_path(locale) %>
        <% if switch_path %>
          <%= link_to switch_path,
            lang: locale,
            hreflang: locale,
            aria: { current: ("true" if locale == current_locale) } do %>
            <span class="locale-code" aria-hidden="true"><%= locale.upcase %></span><span class="locale-name"><%= t("locales.#{locale}") %></span>
          <% end %>
        <% else %>
          <span lang="<%= locale %>" aria-disabled="true"><span class="locale-code" aria-hidden="true"><%= locale.upcase %></span><span class="locale-name"><%= t("locales.#{locale}") %></span></span>
        <% end %>
      <% end %>
    </nav>

    <button
      class="theme-button"
      type="button"
      data-controller="theme"
      data-theme-target="toggle"
      data-theme-light-label-value="<%= t("theme.switch_to_light") %>"
      data-theme-dark-label-value="<%= t("theme.switch_to_dark") %>"
      data-action="theme#toggle"
      aria-label="<%= t("theme.toggle") %>">
      <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
    </button>
  </div>
</header>
